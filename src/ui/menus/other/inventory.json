{
  "namespace": "inventory-form",

  "main": {
    "type": "panel",
    "controls": [
      {
        "main_panel@inventory-form.main_panel": {}
      }
    ]
  },

  "main_panel": {
    "type": "panel",
    "size": [176, 101],
    "controls": [
      {
        "common_panel@common.common_panel": {
          "layer": -1
        }
      },
      { "inventory_panel@inventory-form.inventory_panel": {} },
      { "hotbar_panel@inventory-form.hotbar_panel": {} }
    ]
  },

  "inventory_panel": {
    "type": "panel",
    "size": [162, 54],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [0, -26],
    "controls": [
      {
        "title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "text": "#text",
          "color": "$title_text_color",
          "offset": [0, -11],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§_' + (#title_text - '@mineville/inventory'))",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "sp": {
          "type": "stack_panel",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": ["100%", "100%cm"],
          "controls": [
            {
              "g0@inventory-form.items_template": {
                "$collection_index_offset": 0
              }
            },
            {
              "g1@inventory-form.items_template": {
                "$collection_index_offset": 9
              }
            },
            {
              "g2@inventory-form.items_template": {
                "$collection_index_offset": 18
              }
            }
          ]
        }
      }
    ]
  },

  "hotbar_panel": {
    "type": "panel",
    "size": [162, 18],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [0, -5],
    "controls": [
      {
        "sp": {
          "type": "stack_panel",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": ["100%", "100%cm"],
          "controls": [
            {
              "g3@inventory-form.items_template": {
                "$collection_index_offset": 27
              }
            }
          ]
        }
      }
    ]
  },

  "items_template": {
    "type": "stack_panel",
    "size": ["100%", "100%cm"],
    "orientation": "horizontal",
    "controls": [
      {
        "b0@inventory-form.form_button": {
          "$collection_index": "(0 + $collection_index_offset)"
        }
      },
      {
        "b1@inventory-form.form_button": {
          "$collection_index": "(1 + $collection_index_offset)"
        }
      },
      {
        "b2@inventory-form.form_button": {
          "$collection_index": "(2 + $collection_index_offset)"
        }
      },
      {
        "b3@inventory-form.form_button": {
          "$collection_index": "(3 + $collection_index_offset)"
        }
      },
      {
        "b4@inventory-form.form_button": {
          "$collection_index": "(4 + $collection_index_offset)"
        }
      },
      {
        "b5@inventory-form.form_button": {
          "$collection_index": "(5 + $collection_index_offset)"
        }
      },
      {
        "b6@inventory-form.form_button": {
          "$collection_index": "(6 + $collection_index_offset)"
        }
      },
      {
        "b7@inventory-form.form_button": {
          "$collection_index": "(7 + $collection_index_offset)"
        }
      },
      {
        "b8@inventory-form.form_button": {
          "$collection_index": "(8 + $collection_index_offset)"
        }
      }
    ]
  },

  "form_button": {
    "type": "collection_panel",
    "size": [18, 18],
    "collection_name": "form_buttons",
    "controls": [
      {
        "button@common.button": {
          "collection_index": "$collection_index",
          "$pressed_button_name": "button.form_button_click",
          "controls": [
            {
              "default@inventory-form.form_button_panel": {
                "$hover_state": false
              }
            },
            {
              "hover@inventory-form.form_button_panel": {
                "$hover_state": true
              }
            },
            {
              "pressed@inventory-form.form_button_panel": {
                "$hover_state": true
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#form_button_text = ''))",
              "target_property_name": "#enabled"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "form_button_panel": {
    "type": "panel",
    "controls": [
      {
        "bg_img": {
          "type": "image",
          "texture": "$texture",
          "$texture|default": "textures/ui/cell_image",
          "variables": [
            {
              "requires": "$hover_state",
              "$texture": "textures/ui/slot_disabled_hover"
            }
          ]
        }
      },
      {
        "item": {
          "type": "image",
          "layer": 2,
          "size": [16, 16],
          "texture": "#texture",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "stack_count": {
          "type": "label",
          "color": "$item_stack_count_color",
          "offset": [0, 1],
          "anchor_to": "bottom_right",
          "anchor_from": "bottom_right",
          "layer": 10,
          "shadow": true,
          "text": "#text",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "('%.3s' * #form_button_text)",
              "target_property_name": "#ftext"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#ftext > 1)",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§_' + #ftext)",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "durability_panel": {
          "type": "panel",
          "size": [12, 1],
          "offset": [0, 6],
          "layer": 3,
          "controls": [
            {
              "bg": {
                "type": "image",
                "size": ["100% + 1px", 2],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "color": [0, 0, 0],
                "texture": "textures/ui/common/white"
              }
            },
            {
              "progress": {
                "type": "image",
                "size": ["100% + 1px", 1],
                "offset": [0, -1],
                "layer": 2,
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "texture": "textures/ui/common/white",
                "$f": 1.0,
                "clip_direction": "left",
                "clip_pixelperfect": false,
                "property_bag": {
                  "#max": 100.0,
                  "#color_1": [0.3333, 1, 0.3333, 1],
                  "#color_2": [0.5, 1, 0, 1],
                  "#color_3": [1, 1, 0.3333, 1],
                  "#color_4": [1, 0.3333, 0.3333, 1]
                },
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('_' + #form_button_text)",
                    "target_property_name": "#bt"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(('%.8s' * #bt) - ('%.5s' * #bt))",
                    "target_property_name": "#ftext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#ftext * $f)",
                    "target_property_name": "#ratio"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(1 - (#ratio / #max))",
                    "target_property_name": "#clip_ratio"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#ratio < (#max / 4))",
                    "target_property_name": "#25_perc"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#ratio < (#max / 2))",
                    "target_property_name": "#50_perc"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#ratio < ((#max / 4) + (#max / 2)))",
                    "target_property_name": "#75_perc"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('#color_' + (1 + #25_perc + #50_perc + #75_perc))",
                    "target_property_name": "#color"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "('_' + #form_button_text)",
              "target_property_name": "#bt"
            },
            {
              "binding_type": "view",
              "source_property_name": "(('%.8s' * #bt) - ('%.5s' * #bt))",
              "target_property_name": "#ftext"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#ftext < 100) and (#ftext > -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "hover_text@common.hover_text": {
          "ignored": "(not $hover_state)",
          "layer": 20,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "('_' + #form_button_text)",
              "target_property_name": "#bt"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#bt - ('%.9s' * #bt))",
              "target_property_name": "#ftext"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§_' + #ftext)",
              "target_property_name": "#hover_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#ftext = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
