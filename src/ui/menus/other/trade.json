{
  "namespace": "trade-form",
  "main@common-mineville.form_template": {
    "$title_bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - '@mineville/trade')",
        "target_property_name": "#text"
      }
    ],
    "$content_controls": [
      {
        "content_panel@trade-form.content_panel": {}
      }
    ]
  },

  "content_panel": {
    "type": "stack_panel",
    "size": ["100% - 10px", "100% - 10px"],
    "controls": [
      {
        "body_panel": {
          "type": "panel",
          "size": ["100% - 5px", "100%cm"],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "menu_slot",
              "source_property_name": "#form_text",
              "target_property_name": "#form_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(('%.20s' * #form_text) - #form_text)",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#text = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "background": {
                "type": "image",
                "texture": "textures/ui/common/light_field",
                "offset": ["2.5px", "0px"],
                "size": ["100%", "100%sm + 10px"]
              }
            },
            {
              "label_panel": {
                "type": "panel",
                "offset": ["4.5px", "0px"],
                "size": ["100% - 10px", "100%cm"],
                "controls": [
                  {
                    "label": {
                      "type": "label",
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "text": "#text",
                      "shadow": true,
                      "layer": 1,
                      "max_size": ["100% - 4px", "10px"],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "menu_slot",
                          "source_property_name": "#form_text",
                          "target_property_name": "#form_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "('§_' + (#form_text - ('%.20s' * #form_text)))",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "p1": {
          "type": "panel",
          "size": ["100%", 5],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "menu_slot",
              "source_property_name": "#form_text",
              "target_property_name": "#form_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(('%.20s' * #form_text) - #form_text)",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "main_content@trade-form.main_content": {}
      },
      {
        "p2": {
          "type": "panel",
          "size": ["100%", 5],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "accept_btn_control",
              "source_property_name": "#visible",
              "target_property_name": "#c1"
            },
            {
              "binding_type": "view",
              "source_control_name": "decline_btn_control",
              "source_property_name": "#visible",
              "target_property_name": "#c2"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#c1 or #c2)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "choice_buttons_content@trade-form.choice_buttons_content": {}
      }
    ]
  },

  "main_content": {
    "type": "panel",
    "size": ["100%", "fill"],
    "controls": [
      {
        "wrapper": {
          "type": "panel",
          "size": ["100% - 5px", "100%"],
          "controls": [
            {
              "sp": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": ["100%", "100%"],
                "controls": [
                  {
                    "left": {
                      "type": "image",
                      "texture": "textures/ui/common/dark_field",
                      "size": ["fill", "100%"],
                      "controls": [
                        {
                          "side_layout@trade-form.side_layout": {
                            "$player_nick": "§l§6YOU",
                            "$desc": "Items you give:"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "gap": {
                      "type": "panel",
                      "size": [5, "100%"]
                    }
                  },
                  {
                    "right": {
                      "type": "image",
                      "texture": "textures/ui/common/dark_field",
                      "size": ["fill", "100%"],
                      "controls": [
                        {
                          "side_layout@trade-form.side_layout": {
                            "$use_actual_player_nick": true,
                            "$grid_button_action": "button.null",
                            "$show_delete_hover": false,
                            "$desc": "Items you get:",
                            "$side_collection_offset": 20
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "choice_buttons_content": {
    "type": "panel",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "sp": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["60%", "100%cm"],
          "controls": [
            {
              "accept_cp": {
                "type": "collection_panel",
                "size": ["fill", "100%c"],
                "collection_name": "form_buttons",
                "controls": [
                  {
                    "accept_btn_control@common-mineville.form_button": {
                      "$button_color": "green",
                      "size": ["100% - 5px", 25],
                      "collection_index": 0,
                      "$button_contents": [
                        {
                          "label@common-mineville.mv_form_button_text": {
                            "layer": 1,
                            "offset": [0, -1],
                            "max_size": ["100% - 4px", "100% - 4px"]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons",
                          "binding_name": "#form_button_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not (#form_button_text = ''))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "decline_cp": {
                "type": "collection_panel",
                "size": ["fill", "100%c"],
                "collection_name": "form_buttons",
                "controls": [
                  {
                    "decline_btn_control@common-mineville.form_button": {
                      "$button_color": "red",
                      "size": ["100% - 5px", 25],
                      "collection_index": 1,
                      "$button_contents": [
                        {
                          "label@common-mineville.mv_form_button_text": {
                            "layer": 1,
                            "offset": [0, -1],
                            "max_size": ["100% - 4px", "100% - 4px"]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons",
                          "binding_name": "#form_button_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not (#form_button_text = ''))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "side_layout": {
    "type": "panel",
    "size": ["100% - 6px", "100% - 4px"],
    "$use_actual_player_nick|default": false,
    "controls": [
      {
        "scroll_panel@common.scrolling_panel": {
          "size": ["100%", "100%"],
          "$show_background": false,
          "$scrolling_content": "trade-form.wrapper",
          "$scroll_box_touch_image_control": "common-mineville.scroll_box_touch_image_control",
          "$scroll_box_mouse_image_control": "common-mineville.scroll_box_mouse_image_control",
          "$scroll_size": ["5px", "100% - 2px"],
          "$scroll_bar_left_padding_size": ["1px", "0px"],
          "$scroll_bar_right_padding_size": ["1px", "0px"]
        }
      }
    ]
  },

  "wrapper": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "p2": {
          "type": "panel",
          "size": [0, 4]
        }
      },
      {
        "player_nick": {
          "ignored": "$use_actual_player_nick",
          "type": "label",
          "size": ["100%", "default"],
          "max_size": ["100%", 15],
          "font_scale_factor": 1.5,
          "shadow": true,
          "text_alignment": "center",
          "text": "$player_nick"
        }
      },
      {
        "actual_player_nick": {
          "ignored": "(not $use_actual_player_nick)",
          "type": "label",
          "size": ["100%", "default"],
          "max_size": ["100%", 15],
          "font_scale_factor": 1.5,
          "shadow": true,
          "text_alignment": "center",
          "text": "#text",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "menu_slot",
              "source_property_name": "#form_text",
              "target_property_name": "#form_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§l§b' + (('%.20s' * #form_text) - ';'))",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "desc": {
          "type": "label",
          "size": ["100%", "default"],
          "max_size": ["100%", 10],
          "color": [0.6, 0.6, 0.6],
          "font_scale_factor": 0.75,
          "shadow": true,
          "text_alignment": "center",
          "text": "$desc"
        }
      },
      {
        "p3": {
          "type": "panel",
          "size": [0, 3]
        }
      },
      {
        "grid_layout@trade-form.grid_layout": {}
      },
      {
        "p4": {
          "type": "panel",
          "size": [0, 1]
        }
      }
    ]
  },

  "grid_layout": {
    "type": "panel",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "sp": {
          "type": "stack_panel",
          "size": ["100%", "100%c"],
          "$side_collection_offset|default": 0,
          "controls": [
            {
              "s0@trade-form.grid_layout_sph_template": {
                "$sph_collection_offset": "(2 + $side_collection_offset)"
              }
            },
            {
              "s1@trade-form.grid_layout_sph_template": {
                "$sph_collection_offset": "(6 + $side_collection_offset)"
              }
            },
            {
              "s2@trade-form.grid_layout_sph_template": {
                "$sph_collection_offset": "(10 + $side_collection_offset)"
              }
            },
            {
              "s3@trade-form.grid_layout_sph_template": {
                "$sph_collection_offset": "(14 + $side_collection_offset)"
              }
            },
            {
              "s4@trade-form.grid_layout_sph_template": {
                "$sph_collection_offset": "(18 + $side_collection_offset)"
              }
            }
          ]
        }
      }
    ]
  },

  "grid_layout_sph_template": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "100%cm"],
    "controls": [
      {
        "b0@trade-form.grid_button": {
          "$collection_index": "(0 + $sph_collection_offset)"
        }
      },
      {
        "b1@trade-form.grid_button": {
          "$collection_index": "(1 + $sph_collection_offset)"
        }
      },
      {
        "b2@trade-form.grid_button": {
          "$collection_index": "(2 + $sph_collection_offset)"
        }
      },
      {
        "b3@trade-form.grid_button": {
          "$collection_index": "(3 + $sph_collection_offset)"
        }
      }
    ]
  },

  "grid_button": {
    "type": "stack_panel",
    "size": ["25%", "90%x"],
    "collection_name": "form_buttons",
    "$grid_button_action|default": "button.form_button_click",
    "$show_delete_hover|default": true,
    "$n": "('btn' + $collection_index)",
    "controls": [
      {
        "$n@common.button": {
          "collection_index": "$collection_index",
          "$pressed_button_name": "$grid_button_action",
          "controls": [
            {
              "default@trade-form.grid_button_panel": {
                "$hover_state": false
              }
            },
            {
              "hover@trade-form.grid_button_panel": {
                "$hover_state": true
              }
            },
            {
              "pressed@trade-form.grid_button_panel": {
                "$hover_state": true
              }
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "$pressed_button_name",
              "mapping_type": "focused"
            },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "$pressed_button_name",
              "mapping_type": "pressed"
            },
            {
              "to_button_id": "$pressed_button_name",
              "mapping_type": "pressed"
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "tt@trade-form.trade_tooltip": {
          "collection_index": "$collection_index"
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$n",
        "source_property_name": "#visible",
        "target_property_name": "#visible"
      }
    ]
  },

  "trade_tooltip": {
    "type": "button",
    "$pressed_button_name": "button.form_button_click",
    "size": ["100%", "100%"],
    "focus_enabled": false,
    "default_control": "dflt",
    "hover_control": "hvr",
    "pressed_control": "dflt",
    "button_mappings": [],
    "controls": [
      { "dflt": { "type": "panel", "size": [0, 0] } },
      {
        "hvr": {
          "type": "panel",
          "size": [0, 0],
          "controls": [
            {
              "hover_text@common.hover_text": {
                "layer": 150,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#t"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#t - 'add;')",
                    "target_property_name": "#hover_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#t = '') and not (#t = 'add;'))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "grid_button_panel": {
    "type": "panel",
    "controls": [
      {
        "wrapper": {
          "type": "panel",
          "size": ["100% - 2px", "100% - 2px"],
          "controls": [
            {
              "main_bg_img": {
                "type": "image",
                "texture": "textures/ui/common/light_field",
                "controls": [
                  {
                    "delete_hover": {
                      "size": ["100% - 2px", "100% - 2px"],
                      "ignored": "(not ($hover_state and $show_delete_hover))",
                      "type": "image",
                      "texture": "textures/ui/common/white",
                      "color": [1, 0, 0],
                      "alpha": 0.33,
                      "animation_reset_name": "$pressed_button_name",
                      "anims": [
                        "@trade-form.grid_button_anim_3_remove_hover_alpha_entry"
                      ],
                      "controls": [
                        {
                          "delete_hover": {
                            "layer": 3,
                            "size": [10, 10],
                            "type": "image",
                            "texture": "textures/ui/common/cross",
                            "color": [1, 0, 0],
                            "animation_reset_name": "$pressed_button_name",
                            "anims": [
                              "@trade-form.grid_button_anim_4_remove_hover_icon_alpha_entry"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "item": {
                      "type": "image",
                      "layer": 2,
                      "size": [24, 24],
                      "texture": "#texture",
                      "allow_debug_missing_texture": false,
                      "bindings": [
                        {
                          "binding_name": "#form_button_texture",
                          "binding_name_override": "#texture",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_name": "#form_button_texture_file_system",
                          "binding_name_override": "#texture_file_system",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#text = 'add;'))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "add_bg_img": {
                "type": "image",
                "texture": "textures/ui/common/green_field",
                "controls": [
                  {
                    "hover": {
                      "size": ["100% - 2px", "100% - 2px"],
                      "ignored": "(not $hover_state)",
                      "type": "image",
                      "texture": "textures/ui/common/white",
                      "alpha": 0.25,
                      "animation_reset_name": "$pressed_button_name",
                      "anims": [
                        "@trade-form.grid_button_anim_5_hover_alpha_entry"
                      ]
                    }
                  },
                  {
                    "icon": {
                      "layer": 2,
                      "type": "image",
                      "size": [10, 10],
                      "texture": "textures/ui/common/plus"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#text = 'add;')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "hover_tooltip": {
                "type": "panel",
                "ignored": "(not $hover_state)",
                "size": [0, 0],
                "controls": [
                  {
                    "hover_text@common.hover_text": {
                      "layer": 150,
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons",
                          "binding_name_override": "#t"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(#t - 'add;')",
                          "target_property_name": "#hover_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not (#t = '') and not (#t = 'add;'))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "grid_button_anim_3_remove_hover_alpha_entry": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "from": 0.0,
    "to": 0.33,
    "duration": 0.25
  },

  "grid_button_anim_4_remove_hover_icon_alpha_entry": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "from": 0.0,
    "to": 1.0,
    "duration": 0.25
  },

  "grid_button_anim_5_hover_alpha_entry": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "from": 0.0,
    "to": 0.25,
    "duration": 0.25
  },

  "grid_button_anim_1_wait": {
    "anim_type": "wait",
    "duration": "$grid_button_anim_1_wait_duration",
    "next": "@trade-form.grid_button_anim_1_alpha_entry"
  },
  "grid_button_anim_1_alpha_entry": {
    "anim_type": "alpha",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": 0.0,
    "to": 1.0
  },

  "grid_button_anim_2_wait": {
    "anim_type": "wait",
    "duration": "$grid_button_anim_1_wait_duration",
    "next": "@trade-form.grid_button_anim_2_offset_entry"
  },
  "grid_button_anim_2_offset_entry": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [0, 10],
    "to": [0, 0]
  }
}
