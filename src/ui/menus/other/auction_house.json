  "radio_button_control_template": {
    "type": "panel",
    "controls": [
      {
        "texture": {
          "type": "image",
          "size": ["100%sm", "100%sm"],
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "texture": "#texture",
          "property_bag": {
            "#is_hover": "$hover_state",
            "#type_0": "dark/unchecked",
            "#type_1": "dark/checked",
            "#type_2": "dark/unchecked_hover",
            "#type_3": "dark/checked"
          },
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name_override": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#text - 'selected;') = #text))",
              "target_property_name": "#has_slected"
            },
            {
              "binding_type": "view",
              "source_property_name": "('#type_' + ((1 * #has_slected) + (2 * #is_hover)))",
              "target_property_name": "#ftype"
            },
            {
              "binding_type": "view",
              "source_property_name": "('textures/mineville/ui/buttons/' + #ftype)",
              "target_property_name": "#texture"
            }
          ],
          "controls": [
            {
              "text": {
                "type": "label",
                "layer": 3,
                "text": "#text",
                "size": ["100% - 6px", "default"],
                "max_size": ["100% - 6px", 20],
                "text_alignment": "center",
                "property_bag": {
                  "#offset_0": [0, -1],
                  "#offset_1": [0, 0]
                },
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#form_button_text - 'selected;') = #form_button_text))",
                    "target_property_name": "#has_slected"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('#offset_' + (1 * #has_slected))",
                    "target_property_name": "#offset"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#form_button_text - 'selected;' - ';')",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "texture_size_controller_0": {
          "type": "panel",
          "size": ["100%", "100%"],
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name_override": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#text - 'selected;') = #text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "texture_size_controller_1": {
          "type": "panel",
          "size": ["100%", "100% - 2px"],
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name_override": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#text - 'selected;') = #text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
