                  "source_property_name": "(not #toggle_state)",
                  "target_property_name": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "chat_screen_content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "100%"],
    "controls": [
      {
        "chat_panel@common.empty_panel": {
          "size": ["fill", "100%"],
          "controls": [
            {
              "background@common.input_panel": {
                "prevent_touch_input": true,
                "ignored": true,
                "size": ["100%", "100%"],
                "layer": 98,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "toggle_command_sidebar",
                    "source_property_name": "(#toggle_state)",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "clhose@chat.toggle": {
                      "$toggle_view_binding_name": "close_command_sidebar",
                      "$toggle_group_forced_index": 2,
                      "size": ["100%", "100%"],
                      "$toggle_texture": "textures/ui/chat/icon/close",
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "alpha": 0,
                      "$sound_name": "random.chestclosed",
                      "$sound_pitch": 1,
                      "$sound_volume": 0.5,
                      "propagate_alpha": true
                    }
                  },
                  {
                    "bg": {
                      "type": "image",
                      "alpha": 0.5,
                      "texture": "textures/ui/Black"
                    }
                  }
                ]
              }
            },
            {
              "messages_panel@chat.messages_scrolling_panel": {}
            },
            {
              "chat_bottom_panel@chat.chat_bottom_panel": {
                "layer": 2
              }
            },
            {
              "chat_top_panel@chat.chat_header": {
                "layer": 2
              }
            },
            {
              "new_messages_button@chat.new_messages_button": {
                "layer": 3
              }
            },
            {
              "autocomplete_commands_panel@chat.commands_panel": {
                "layer": 3
              }
            },
            {
              "host_main_panel@host_options.host_panel": {
                "layer": 4
              }
            },
            {
              "popup_factory@chat_settings.popup_factory": {}
            }
          ]
        }
      },
      {
        "commands@chat.core": {}
      }
    ]
  },
  "white@common.empty_panel": {
    "debug": "$debug",
    "controls": [
      {
        "q@chat.image": {}
      }
    ]
  },
  "toggle@common_toggles.light_content_toggle": {
    "$unchecked_control": "chat.image",
    "$checked_control": "chat.white",
    "$unchecked_hover_control": "chat.white",
    "$checked_hover_control": "chat.white",
    "$unchecked_pressed_control": "chat.white",
    "$checked_pressed_control": "chat.white",
    "$button_type_panel": "common.empty_panel",
    "size": [20, 20],
    "$size": ["100%-10px", "100%-10px"],
    "$debug|default": "white",
    "$radio_toggle_group": true,
    "$toggle_name": "command_sidebar",
    "consume_hover_events": false,
    "$button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.panel_enter",
        "mapping_type": "pressed",
        "consume_event": false,
        "input_mode_condition": "not_gamepad"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.panel_enter",
        "mapping_type": "focused",
        "consume_event": false,
        "input_mode_condition": "gamepad_and_not_gaze"
      }
    ]
  }
}
