{
  "messages_text/text": {
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "(not (('%.7s' * #text) = '%toast%'))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (('%.7s' * #text) = '%toast%'))",
        "target_property_name": "#enabled"
      }
    ]
  },
  "command@common.button": {
    "$command|default": "/say Placeholder Command",
    "$additional_text_only_label_not_included_as_command_or_chat|default": "",
    "$pressed_button_name": "button.nodata",
    "size": "$btnsize",
    "$btnsize|default": ["100%", 26],
    "$is_chat_not_command|default": false,
    "$command_tooltip|default": "This is a command",
    "$modifier|default": "#item_name_with_command",
    "$default_button_texture": "textures/ui/chat/button/white_default",
    "$hover_button_texture": "textures/ui/chat/button/white_hover",
    "$pressed_button_texture": "textures/ui/chat/button/white_pressed",
    "$s": false,
    "$btntxtsize|default": ["100%-6px", "100%-4px"],
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "$default_button_texture",
          "size": ["100%", "100%-2px"],
          "controls": [
            {
              "label": {
                "type": "label",
                "text": "$text",
                "variables": [
                  {
                    "requires": "$is_chat_not_command",
                    "$text": "($additional_text_only_label_not_included_as_command_or_chat+$command)"
                  },
                  {
                    "requires": "(not $is_chat_not_command)",
                    "$text": "$command"
                  }
                ],
                "size": "$btntxtsize",
                "anchor_to": "center",
                "layer": 4,
                "color": "black",
                "shadow": "$s",
                "offset": [0, 4],
                "text_alignment": "center",
                "anchor_from": "center"
              }
            }
          ]
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "$hover_button_texture",
          "size": ["100%", "100%-2px"],
          "controls": [
            {
              "label": {
                "type": "label",
                "text": "$text",
                "variables": [
                  {
                    "requires": "$is_chat_not_command",
                    "$text": "($additional_text_only_label_not_included_as_command_or_chat+$command)"
                  },
                  {
                    "requires": "(not $is_chat_not_command)",
                    "$text": "$command"
                  }
                ],
                "size": "$btntxtsize",
                "anchor_to": "center",
                "layer": 4,
                "color": "black",
                "shadow": "$s",
                "offset": [0, 4],
                "text_alignment": "center",
                "anchor_from": "center"
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "$pressed_button_texture",
          "size": ["100%", "100%-2px"],
          "controls": [
            {
              "label": {
                "type": "label",
                "text": "$text",
                "variables": [
                  {
                    "requires": "$is_chat_not_command",
                    "$text": "($additional_text_only_label_not_included_as_command_or_chat+$command)"
                  },
                  {
                    "requires": "(not $is_chat_not_command)",
                    "$text": "$command"
                  }
                ],
                "size": "$btntxtsize",
                "anchor_to": "center",
                "layer": 4,
                "color": "black",
                "shadow": "$s",
                "offset": [0, 4],
                "text_alignment": "center",
                "anchor_from": "center"
              }
            }
          ]
        }
      },
      {
        "text_edit_box": {
          "type": "edit_box",
          "text_box_name": "#message_text_box",
          "max_length": 2147483647,
          "can_be_deselected": true,
          "text_control": "text_control",
          "focus_enabled": true,
          "size": ["100%sm", "100%sm"],
          "offset": [2, 0],
          "layer": 3,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$button_mappings|default": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.keyboard_toggle",
              "handle_select": true,
              "handle_deselect": false,
              "mapping_type": "pressed",
              "input_mode_condition": "not_gamepad"
            },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.text_edit_box_selected",
              "handle_select": true,
              "handle_deselect": false,
              "mapping_type": "pressed",
              "input_mode_condition": "not_gamepad"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.text_edit_box_selected",
              "handle_select": true,
              "handle_deselect": false,
              "mapping_type": "focused",
              "input_mode_condition": "gamepad_and_not_gaze"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.send",
              "handle_select": false,
              "handle_deselect": true,
              "consume_event": false,
              "mapping_type": "focused",
              "scope": "global",
              "input_mode_condition": "gamepad_and_not_gaze"
            },
            {
              "from_button_id": "button.menu_cancel",
              "to_button_id": "button.menu_select",
              "handle_select": false,
              "handle_deselect": true,
              "mapping_type": "global"
            }
          ],
          "button_mappings": "$button_mappings",
          "variables": [
            {
              "requires": "$touch",
              "$button_mappings": [
                {
                  "from_button_id": "button.menu_select",
                  "to_button_id": "button.keyboard_toggle",
                  "handle_select": true,
                  "handle_deselect": false,
                  "mapping_type": "pressed"
                },
                {
                  "from_button_id": "button.menu_select",
                  "to_button_id": "button.text_edit_box_selected",
                  "handle_select": true,
                  "handle_deselect": false,
                  "mapping_type": "pressed"
                },
                {
                  "from_button_id": "button.menu_ok",
                  "to_button_id": "button.text_edit_box_selected",
                  "handle_select": false,
                  "handle_deselect": true,
                  "mapping_type": "pressed"
                },
                {
                  "from_button_id": "button.menu_cancel",
                  "to_button_id": "button.menu_select",
                  "handle_select": false,
                  "handle_deselect": true,
                  "mapping_type": "global"
                }
              ]
            }
          ],
          "controls": [
            {
              "text_control": {
                "type": "label",
                "text": "#item_name",
                "visible": false,
                "property_bag": {
                  "#property_field": "#item_name"
                },
                "localize": false,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "display_text",
                    "source_property_name": "#item_name",
                    "target_property_name": "#text_content"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#text_content+' ') + $command)",
                    "ignored": "$is_chat_not_command",
                    "target_property_name": "#item_name_with_command"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#text_content + $command)",
                    "ignored": "(not $is_chat_not_command)",
                    "target_property_name": "#item_name_with_command"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "$modifier",
                    "target_property_name": "#item_name"
                  }
                ]
              }
            },
            {
              "tooltip@common.button": {
                "hover_control": "hover",
                "controls": [
                  {
                    "hover@common.hover_text": {
                      "property_bag": {
                        "#hover_text": "$command_tooltip"
                      }
                    }
                  }
                ],
                "consume_hover_events": false,
                "button_mappings": [
                  {
                    "to_button_id": "button.null",
                    "mapping_type": "global",
                    "consume_event": false
                  },
                  {
                    "to_button_id": "button.null",
                    "mapping_type": "pressed",
                    "consume_event": false
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "sendbutton@common_buttons.light_text_button": {
          "layer": 0,
          "propagate_alpha": true,
          "always_listen_to_input": true,
          "alpha": 0,
          "size": ["100%sm", "100%sm"],
          "offset": [2, 0],
          "ignored": "$is_chat_not_command",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$button_text": "exit",
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.send",
              "consume_event": false,
              "mapping_type": "pressed",
              "scope": "global",
              "input_mode_condition": "not_gamepad"
            }
          ]
        }
      }
    ]
  },
  "category": {
    "type": "panel",
    "size": ["100%", "100%c"],
    "$content|default": [],
    "controls": [
      {
        "label": {
          "type": "image",
          "texture": "textures/ui/chat/panel/title",
          "size": ["100%", 20],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "label": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [0, 0],
                "text": "$category",
                "shadow": true
              }
            },
            {
              "$category@common.toggle": {
                "size": ["100%", 20],
                "checked_control": "pressed",
                "unchecked_control": "default",
                "checked_hover_control": "hover_pressed",
                "unchecked_locked_control": "locked",
                "checked_locked_control": "locked",
                "unchecked_hover_control": "hover_default",
                "toggle_default_state": false,
                "controls": [
                  {
                    "hover_pressed@common.empty_panel": {
                      "debug": "white",
                      "controls": [
                        {
                          "dd@chat.dropdownarrow": {
                            "texture": "textures/ui/chat/icon/arrdown"
                          }
                        },
                        {
                          "hover@common.hover_text": {
                            "layer": 999,
                            "property_bag": {
                              "#hover_text": "Click to Close"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "hover_default@common.empty_panel": {
                      "debug": "white",
                      "controls": [
                        {
                          "dd@chat.dropdownarrow": {
                            "texture": "textures/ui/chat/icon/arrleft"
                          }
                        },
                        {
                          "hover@common.hover_text": {
                            "layer": 999,
                            "property_bag": {
                              "#hover_text": "Click to Open"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "default@chat.dropdownarrow": {
                      "texture": "textures/ui/chat/icon/arrleft"
                    }
                  },
                  {
                    "pressed@chat.dropdownarrow": {
                      "texture": "textures/ui/chat/icon/arrdown"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "size": ["100%", "100%c+3px"],
          "offset": [0, 20],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": "$content",
          "bindings": [
            {
              "binding_type": "view",
              "resolve_sibling_scope": true,
              "source_control_name": "$category",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "image@common.empty_image": {
    "texture": "$toggle_texture",
    "size": "$size"
  },
  "dropdownarrow@common.empty_image": {
    "offset": [-6, 0],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "size": [6, 6]
  },
