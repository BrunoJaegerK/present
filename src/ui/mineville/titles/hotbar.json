{
    "namespace": "mv_title_hotbar",

    "root_panel@mv_template_title.title_panel": {
        "$title_id": "hb",
        "$controls": [
            {
                "hotbar_panel": {
                    "type": "panel",
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "size": [180, 36],
                    "controls": [
                        {
                            "stack_panel": {
                                "type": "stack_panel",
                                "size": ["100%", "100%"],
                                "orientation": "horizontal",
                                "controls": [
                                    {
                                        "slot_0_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 0
                                        }
                                    },
                                    {
                                        "slot_1_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 1
                                        }
                                    },
                                    {
                                        "slot_2_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 2
                                        }
                                    },
                                    {
                                        "slot_3_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 3
                                        }
                                    },
                                    {
                                        "slot_4_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 4
                                        }
                                    },
                                    {
                                        "slot_5_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 5
                                        }
                                    },
                                    {
                                        "slot_6_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 6
                                        }
                                    },
                                    {
                                        "slot_7_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 7
                                        }
                                    },
                                    {
                                        "slot_8_panel@mv_title_hotbar.slot_panel": {
                                            "$slot_id": 8
                                        }
                                    },
                                    {
                                        "selected_panel": {
                                            "type": "panel",
                                            "size": [20, "100%"],
                                            "controls": [
                                                {
                                                    "arrow_image": {
                                                        "type": "image",
                                                        "anchor_from": "top_middle",
                                                        "anchor_to": "top_middle",
                                                        "size": [7, 7],
                                                        "texture": "textures/mineville/ui/icons/arrow_down",
                                                        "anims": ["@mv_title_hotbar.anim_arrow_down"]
                                                    }
                                                },
                                                {
                                                    "border_panel": {
                                                        "type": "panel",
                                                        "anchor_from": "bottom_middle",
                                                        "anchor_to": "bottom_middle",
                                                        "size": [20, 20],
                                                        "offset": [0, -2],
                                                        "controls": [
                                                            {
                                                                "border_1_image": {
                                                                    "type": "image",
                                                                    "texture": "textures/mineville/ui/assets/border",
                                                                    "layer": 20,
                                                                    "alpha": "@mv_title_hotbar.anim_border_alpha",
                                                                    "anims": ["@mv_title_hotbar.anim_border_size"]
                                                                }
                                                            },
                                                            {
                                                                "border_2_image": {
                                                                    "type": "image",
                                                                    "texture": "textures/mineville/ui/assets/border",
                                                                    "layer": 20,
                                                                    "anims": ["@mv_title_hotbar.anim_border_size_wait", "@mv_title_hotbar.anim_border_alpha_wait"]
                                                                }
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "fill_panel": {
                                            "type": "panel",
                                            "size": ["fill", "100%"]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "slot_panel": {
        "type": "panel",
        "$slot_id|default": 0,
        "size": [20, "100%"],
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$title_id",
                "source_property_name": "#preserved_text",
                "target_property_name": "#preserved_text"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#preserved_text - $update_string) > $slot_id)",
                "target_property_name": "#visible"
            }
        ]
    },

    "anim_arrow_down": {
        "anim_type": "offset",
        "from": [0, 0],
        "to": [0, 2],
        "duration": 0.5,
        "easing": "in_out_sine",
        "next": "@mv_title_hotbar.anim_arrow_up"
    },

    "anim_arrow_up": {
        "anim_type": "offset",
        "from": [0, 2],
        "to": [0, 0],
        "duration": 0.5,
        "easing": "in_out_sine",
        "next": "@mv_title_hotbar.anim_arrow_down"
    },

    "anim_border_size": {
        "anim_type": "size",
        "from": [20, 20],
        "to": [28, 28],
        "duration": 0.5,
        "easing": "linear",
        "next": "@mv_title_hotbar.anim_border_size_wait"
    },

    "anim_border_alpha": {
        "anim_type": "alpha",
        "from": 0.7,
        "to": 0,
        "duration": 0.5,
        "easing": "linear",
        "next": "@mv_title_hotbar.anim_border_alpha_wait"
    },

    "anim_border_size_wait": {
        "anim_type": "wait",
        "duration": 0.25,
        "next": "@mv_title_hotbar.anim_border_size"
    },

    "anim_border_alpha_wait": {
        "anim_type": "wait",
        "duration": 0.25,
        "next": "@mv_title_hotbar.anim_border_alpha"
    }
}