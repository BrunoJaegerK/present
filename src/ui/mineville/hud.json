{
  "namespace": "mv_hud",

  "root_panel": {
    "type": "panel",
    "controls": [
      {
        "titles_panel@mv_hud.titles_panel": {}
      },
      {
        "sidebar@scoreboard.mv_scoreboard_sidebar": {
          "bindings": [
            {
              "binding_name": "#scoreboard_sidebar_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "preserved_elements@mv_hud.preserved_elements": {}
      }
    ]
  },

  "titles_panel": {
    "type": "panel",
    "controls": [
      {
        "hotbar_panel@mv_title_hotbar.root_panel": {}
      },
      {
        "objective_panel@mv_title_objective.root_panel": {}
      },
      {
        "note_panel@mv_title_note.root_panel": {}
      },
      // { "toast_panel@mv_title_toast.root_panel": { } }
    ]
  },

  "preserved_elements": {
    "type": "panel",
    "controls": [
      {
        "armor_hud@mv_armor_hud.armor_hud": {}
      }
    ]
  },

  "preserved_data": {
    "type": "panel",
    "controls": [
      {
        "data_control_1@data_template": {
          "$source_property_name": "((not (#hud_title_text_string = #title_data)) and (('%.14s' * #hud_title_text_string = 'mv;show_armor;') or ('%.14s' * #hud_title_text_string = 'mv;hide_armor;')))"
        }
      }
    ]
  },

  "data_template": {
    "type": "panel",
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#title_data",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "$source_property_name",
        "target_property_name": "#visible",
        "resolve_sibling_scope": true
      }
    ]
  }
}
