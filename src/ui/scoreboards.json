{
  "namespace": "scoreboard",

  "mv_scoreboard_sidebar": {
    "type": "panel",
    "size": ["100%cm", "100%c"],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "controls": [
      {
        "main": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": "#alpha",
          "size": ["100%cm + 4px", "100%c"],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "bindings": [
            {
              "binding_name": "#objective_background_opacity",
              "binding_name_override": "#alpha"
            }
          ],
          "controls": [
            {
              "sp": {
                "type": "stack_panel",
                "size": ["100%cm", "100%c"],
                "use_child_anchors": true,
                "controls": [
                  {
                    "displayed_objective": {
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "type": "label",
                      "size": ["default", 10],
                      "text": "#objective_sidebar_name",
                      "text_alignment": "center",
                      "locked_alpha": 1.0,
                      "layer": 2,
                      "color": "$objective_title_color",
                      "localize": false,
                      "bindings": [
                        {
                          "binding_name": "#objective_sidebar_name",
                          "binding_type": "global"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#objective_sidebar_name - 'mv') = #objective_sidebar_name)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "logo_sp": {
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "type": "stack_panel",
                      "size": ["100%c", "100%c"],
                      "controls": [
                        {
                          "p1": {
                            "type": "panel",
                            "size": [0, 3]
                          }
                        },
                        {
                          "logo_container": {
                            "type": "panel",
                            "size": [63.5, 24.8],
                            "controls": [
                              {
                                "logo": {
                                  "type": "image",
                                  "texture": "textures/ui/title",
                                  "size": ["100%", "100%"],
                                  "layer": 1
                                }
                              }
                            ]
                          }
                        },
                        {
                          "p2": {
                            "type": "panel",
                            "size": [0, 3]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#objective_sidebar_name",
                          "binding_type": "global"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#objective_sidebar_name - 'mv') = #objective_sidebar_name))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "lists": {
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "type": "panel",
                      "inherit_max_sibling_width": true,
                      "size": ["100%c", "100%cm"],
                      "controls": [
                        {
                          "players": {
                            "type": "stack_panel",
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "size": ["100%cm", "100%c"],
                            "orientation": "vertical",
                            "collection_name": "scoreboard_players",
                            "factory": {
                              "name": "player_list_factory",
                              "control_name": "scoreboard.mv_scoreboard_sidebar_player"
                            },
                            "bindings": [
                              {
                                "binding_name": "#scoreboard_sidebar_size",
                                "binding_type": "global",
                                "binding_name_override": "#collection_length"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "mv_scoreboard_sidebar_player": {
    "type": "label",
    "layer": 2,
    "text": "#player_name_sidebar",
    "size": ["default", "default"],
    "font_scale_factor": 0.75,
    "locked_alpha": 1.0,
    "color": "$player_name_color",
    "localize": false,
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      }
    ]
  }
}
